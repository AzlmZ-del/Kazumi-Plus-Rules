{
    "api": "9",
    "type": "anime",
    "name": "giriGiriLove",
    "author": "小鲸鱼",
    "version": "2.7",
    "muliSources": false,
    "useWebview": false,
    "useNativePlayer": false,
    "usePost": false,
    "useLegacyParser": false,
    "adBlocker": false,
    "directConnection": false,
    "baseURL": "https://m3u8.girigirilove.com",
    "userAgent": "",
    "referer": "",
    "searchMode": "api",
    "searchApiConfig": {
        "request": {
            "method": "GET",
            "url": "https://m3u8.girigirilove.com/api.php/Vod/get_list",
            "query": {
                "vod_name": "@keyword",
                "offset": 0,
                "limit": 24
            },
            "bodyType": "none"
        },
        "listPath": "$.info.rows[*]",
        "namePath": "$.vod_name",
        "sourcePath": "$.vod_id"
    },
    "chapterMode": "api",
    "chapterApiConfig": {
        "request": {
            "method": "GET",
            "url": "https://m3u8.girigirilove.com/api.php/Vod/get_detail",
            "query": {
                "vod_id": "@source"
            },
            "bodyType": "none"
        },
        "format": "delimited",
        "roadNamesPath": "$.info.vod_play_from",
        "roadEpisodesPath": "$.info.vod_play_url",
        "roadSeparator": "$$$",
        "episodeSeparator": "#",
        "fieldSeparator": "$"
    }
}