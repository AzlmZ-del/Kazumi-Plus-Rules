{
    "api": "9",
    "type": "anime",
    "name": "次元城",
    "author": "小鲸鱼",
    "version": "2.3",
    "muliSources": false,
    "useWebview": false,
    "useNativePlayer": false,
    "usePost": false,
    "useLegacyParser": false,
    "adBlocker": false,
    "directConnection": true,
    "userAgent": "",
    "baseURL": "https://www.cycani.org",
    "searchMode": "api",
    "searchApiConfig": {
        "request": {
            "method": "GET",
            "url": "https://www.cycani.org/api/videos/search",
            "headers": {
                "X-App-Name": "cyc_web",
                "X-App-Version": "cycweb",
                "X-Time-Zone": "Asia/Shanghai",
                "Accept": "application/json, text/plain, */*"
            },
            "query": {
                "q": "@keyword",
                "page": "1",
                "page_size": "20"
            },
            "bodyType": "none"
        },
        "listPath": "$.data.list[*]",
        "namePath": "$.title",
        "sourcePath": "$.video_id",
        "sourceTemplate": ""
    },
    "chapterMode": "api",
    "chapterApiConfig": {
        "request": {
            "method": "GET",
            "url": "https://www.cycani.org/api/videos/@source/sections",
            "headers": {
                "X-App-Name": "cyc_web",
                "X-App-Version": "cycweb",
                "X-Time-Zone": "Asia/Shanghai",
                "Accept": "application/json, text/plain, */*"
            },
            "query": {
                "player_code": "cychub",
                "page": "1",
                "page_size": "100"
            },
            "bodyType": "none"
        },
        "format": "nested",
        "roadsPath": "",
        "roadNamePath": "",
        "episodesPath": "$.data.list[*]",
        "episodeNamePath": "$.title",
        "episodeUrlPath": "$.id",
        "episodePage": {
            "url": "https://www.cycani.org/api/v2/sections/@episodeUrl/play-url",
            "query": {}
        },
        "variables": {},
        "play": {
            "request": {
                "method": "GET",
                "url": "",
                "headers": {
                    "X-App-Name": "cyc_web",
                    "X-App-Version": "cycweb",
                    "X-Time-Zone": "Asia/Shanghai",
                    "Accept": "application/json, text/plain, */*"
                },
                "query": {},
                "bodyType": "none"
            },
            "urlPath": "$.data.url"
        }
    },
    "referer": "https://www.cycani.org/",
    "auth": {
        "enabled": true,
        "login": {
            "method": "POST",
            "url": "https://www.cycani.org/api/auth/login",
            "headers": {
                "X-App-Name": "cyc_web",
                "X-App-Version": "cycweb",
                "X-Time-Zone": "Asia/Shanghai",
                "Accept": "application/json, text/plain, */*"
            },
            "query": {},
            "bodyType": "json",
            "body": {
                "username": "@username",
                "password": "@password"
            }
        },
        "tokenPath": "$.data.token",
        "headerName": "Authorization",
        "tokenPrefix": "",
        "refreshOnStatus": [
            401
        ]
    },
    "antiCrawlerConfig": {
        "enabled": false,
        "captchaType": 1,
        "captchaImage": "",
        "captchaInput": "",
        "captchaButton": "",
        "captchaDetectType": 1,
        "captchaDetectValue": "",
        "captchaScript": ""
    }
